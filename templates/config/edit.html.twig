{% extends 'base.html.twig' %}

{% block title %} = {{title}}{% endblock %}

{% block body %}
    <h1>{{title}}</h1>

    <div class="position-relative">
        {{ form_start(form) }}

        {{ form_widget(form.submit) }}
        <a href="{{ path(routecancel) }}" class="btn btn-secondary ms-1">Annuler</a>

        {% include('include/error.html.twig') %}

        <div class="card mt-3">
            <div class="card-header">{{ config.title }}</div>
            <div class="card-body">
                <dl class="row mb-3">
                    <dt class="col-sm-3">Code</dt>
                    <dd class="col-sm-9"><code>{{ config.code }}</code></dd>

                    <dt class="col-sm-3">Type</dt>
                    <dd class="col-sm-9">{{ config.type }}</dd>

                    <dt class="col-sm-3">Valeur par défaut</dt>
                    <dd class="col-sm-9">
                        {% if config.type == 'logo' %}
                            <img src="{{ asset(config.defaultValue) }}" alt="{{ config.code }}" style="max-height: 80px; max-width: 200px; object-fit: contain;">
                        {% else %}
                            {{ config.defaultValue }}
                        {% endif %}
                    </dd>
                </dl>

                {{ form_row(form.rawValue) }}
            </div>
        </div>

        {{ form_end(form) }}
    </div>

    {% if routedelete %}
        <form action="{{ path(routedelete, {id: config.id}) }}" method="post" class="mt-3" onsubmit="return confirm('Réinitialiser cette configuration à sa valeur par défaut ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-config-' ~ config.id) }}">
            <button type="submit" class="btn btn-outline-danger">Réinitialiser à la valeur par défaut</button>
        </form>
    {% endif %}
{% endblock %}