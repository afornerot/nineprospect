{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <div class="position-relative">
        {% if routedelete is defined and routedelete %}{% include 'include/delete_button.html.twig' with {route: routedelete, id: contact.id, tokenId: 'delete-contact' ~ contact.id, classes: 'delete-abs'} %}{% endif %}

        {{ form_start(form) }}

        {{ form_widget(form.submit) }}
        {% if redirect is defined and redirect %}
            <a href="{{ redirect }}" class="btn btn-secondary ms-1">Annuler</a>
        {% else %}
            <a href="{{ path(routecancel) }}" class="btn btn-secondary ms-1">Annuler</a>
        {% endif %}

        {% include('include/error.html.twig') %}

        <div class="row">
            <div class="col-md-6 mx-auto">
                <div class="card mt-3">
                    <div class="card-header">Identité</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">{{ form_row(form.prospect) }}</div>
                            <div class="col-md-6">{{ form_row(form.prenom) }}</div>
                            <div class="col-md-6">{{ form_row(form.nom) }}</div>
                            <div class="col-md-12">{{ form_row(form.poste) }}</div>
                            <div class="col-md-12">{{ form_row(form.estPrincipal) }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mx-auto">
                <div class="card mt-3">
                    <div class="card-header">Coordonnées</div>
                        <div class="card-body">
                                {{ form_row(form.email) }}
                                {{ form_row(form.telephoneBrut) }}
                                {{ form_row(form.linkedinUrl) }}
                            </div>
                        </div>
                </div>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
