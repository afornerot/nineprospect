{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <form method="get" action="{{ path('app_user_contacts') }}" class="d-flex flex-wrap gap-2 align-items-end mb-3 w-100">
        <div class="flex-grow-1" style="min-width: 160px;">
            <label class="form-label" for="filtre-utilisateur-contacts">Affecté à</label>
            <select id="filtre-utilisateur-contacts" name="utilisateur" class="form-select" onchange="this.form.submit()">
                <option value="">Tous</option>
                {% for u in utilisateurs %}
                    <option value="{{ u.id }}" {% if utilisateurFiltre == u.id %}selected{% endif %}>{{ u.username }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="flex-shrink-0">
            <button type="submit" class="btn btn-primary">Filtrer</button>
        </div>
        <div class="flex-shrink-0">
            <a href="{{ path('app_user_contacts') }}" class="btn btn-secondary">Réinitialiser</a>
        </div>
    </form>

    <a href="{{ path(routesubmit, {redirect: path('app_user_contacts')}) }}" class="btn btn-success mb-3">Ajouter</a>

    <div class="dataTable_wrapper">
        <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%" data-order-col="1" data-order-dir="asc">
            <thead>
            <tr>
                <th width="90px" class="no-sort">Action</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Poste</th>
                <th>Prospect</th>
                <th width="40px">Principal</th>
            </tr>
            </thead>
            <tbody>
                {% for contact in contacts %}
                    <tr>
                        <td>
                            <a href="{{ path(routeupdate, {id: contact.id, redirect: path('app_user_contacts')}) }}" title="Modifier"><i class="fas fa-file fa-2x"></i></a>
                            {% if contact.prospect %}
                                <a href="{{ path(routeprospect, {id: contact.prospect.id}) }}" title="Fiche prospect"><i class="fas fa-building fa-2x"></i></a>
                            {% endif %}
                        </td>
                        <td>{{ contact.nomComplet }}</td>
                        <td>{{ contact.email }}</td>
                        <td>{{ contact.telephone ?: contact.telephoneBrut }}</td>
                        <td>{{ contact.poste ?: '—' }}</td>
                        <td>{{ contact.prospect ? contact.prospect.nom : '—' }}</td>
                        <td>{% if contact.estPrincipal %}<i class="fas fa-star text-warning"></i>{% endif %}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
