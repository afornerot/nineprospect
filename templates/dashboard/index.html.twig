{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <form method="get" action="{{ path('app_user_dashboard') }}" class="d-flex align-items-end gap-3 flex-wrap mb-3">
        <div>
            <label for="filtre-utilisateur-dashboard" class="form-label small text-muted mb-1 d-block">Affecté à</label>
            <select id="filtre-utilisateur-dashboard" name="utilisateur" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                <option value="">Tous</option>
                {% for u in utilisateurs %}
                    <option value="{{ u.id }}" {% if utilisateurFiltre == u.id %}selected{% endif %}>{{ u.username }}</option>
                {% endfor %}
            </select>
        </div>
        <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Filtrer</button></noscript>
        <span class="text-muted small"><i class="fas fa-filter"></i> Les KPIs et cartes sont filtrés par l'utilisateur sélectionné.</span>
    </form>

    <div class="row g-2">
        <div class="col-md-4">
            <div class="row text-center g-2 mb-2">
                <div class="col">
                    <div class="card"><div class="card-body">
                        <div class="display-6">{{ kpi.prospects }}</div>
                        <div class="text-muted">Prospects</div>
                        <a href="{{ path('app_user_prospects') }}" class="stretched-link" aria-label="Prospects"></a>
                    </div></div>
                </div>
                <div class="col">
                    <div class="card"><div class="card-body">
                        <div class="display-6">{{ kpi.contacts }}</div>
                        <div class="text-muted">Contacts</div>
                        <a href="{{ path('app_user_contacts') }}" class="stretched-link" aria-label="Contacts"></a>
                    </div></div>
                </div>
            </div>

            <div class="row text-center g-2 mb-2">
                <div class="col">
                    <div class="card"><div class="card-body">
                        <div class="display-6 text-{% if kpi.actionsEnRetard > 0 %}danger{% else %}success{% endif %}">{{ kpi.actionsEnRetard }}</div>
                        <div class="text-muted">Actions en retard</div>
                        <a href="{{ path('app_user_actions', {vue: 'retard'}) }}" class="stretched-link" aria-label="Actions en retard"></a>
                    </div></div>
                </div>
                <div class="col">
                    <div class="card"><div class="card-body">
                        <div class="display-6 text-{% if kpi.actionsAujourdhui > 0 %}warning{% else %}success{% endif %}">{{ kpi.actionsAujourdhui }}</div>
                        <div class="text-muted">Aujourd'hui</div>
                        <a href="{{ path('app_user_actions', {vue: 'aujourdhui'}) }}" class="stretched-link" aria-label="Actions à faire aujourd'hui"></a>
                    </div></div>
                </div>
                <div class="col">
                    <div class="card"><div class="card-body">
                        <div class="display-6 text-{% if kpi.actionsAVenir > 0 %}info{% else %}secondary{% endif %}">{{ kpi.actionsAVenir }}</div>
                        <div class="text-muted">Actions à venir</div>
                        <a href="{{ path('app_user_actions', {vue: 'avenir'}) }}" class="stretched-link" aria-label="Actions à venir"></a>
                    </div></div>
                </div>
            </div>

            <div class="row text-center g-2 mb-2">
                <div class="col">
                    <div class="card"><div class="card-body">
                        <div class="display-6 text-{% if kpi.nonContacte > 0 %}warning{% else %}success{% endif %}">{{ kpi.nonContacte }}</div>
                        <div class="text-muted">Non contactés</div>
                        <a href="{{ path('app_user_prospects', {contacte: 'non'}) }}" class="stretched-link" aria-label="Prospects non contactés"></a>
                    </div></div>
                </div>
                <div class="col">
                    <div class="card"><div class="card-body">
                        <div class="display-6 text-{% if kpi.nonQualifie > 0 %}warning{% else %}success{% endif %}">{{ kpi.nonQualifie }}</div>
                        <div class="text-muted">Non qualifiés</div>
                        <a href="{{ path('app_user_prospects', {qualifie: 'non'}) }}" class="stretched-link" aria-label="Prospects non qualifiés"></a>
                    </div></div>
                </div>
            </div>

            <div class="card mb-2">
                <div class="card-header">Pipeline</div>
                <div class="card-body">
                    <form method="get" action="{{ path('app_user_dashboard') }}" class="mb-3">
                        <div class="mb-2">
                            <label for="filtre-pipeline-pipeline" class="form-label small text-muted mb-1 d-block">Pipeline</label>
                            <select name="pipeline" id="filtre-pipeline-pipeline" class="form-select form-select-sm w-100" onchange="this.form.submit()">
                                {% for pipeline in pipelines %}
                                    <option value="{{ pipeline.id }}" {% if filtrePipeline == pipeline.id %}selected{% endif %}>{{ pipeline }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-2">
                            <label for="filtre-sprint-pipeline" class="form-label small text-muted mb-1 d-block">Vague</label>
                            <select name="sprint" id="filtre-sprint-pipeline" class="form-select form-select-sm w-100" onchange="this.form.submit()">
                                <option value="">Toutes les vagues</option>
                                {% for sprint in sprints %}
                                    <option value="{{ sprint.id }}" {% if filtreSprint == sprint.id %}selected{% endif %}>{{ sprint }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-2">
                            <label for="filtre-produit-pipeline" class="form-label small text-muted mb-1 d-block">Produit</label>
                            <select name="produit" id="filtre-produit-pipeline" class="form-select form-select-sm w-100" onchange="this.form.submit()">
                                <option value="">Toutes les produits</option>
                                {% for produit in produits %}
                                    <option value="{{ produit.id }}" {% if filtreProduit == produit.id %}selected{% endif %}>{{ produit.titre }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-2">
                            <label for="filtre-cible-pipeline" class="form-label small text-muted mb-1 d-block">Cible</label>
                            <select name="cible" id="filtre-cible-pipeline" class="form-select form-select-sm w-100" onchange="this.form.submit()">
                                <option value="">Toutes les cibles</option>
                                {% for cible in cibles %}
                                    <option value="{{ cible.id }}" {% if filtreCible == cible.id %}selected{% endif %}>{{ cible.nom }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Filtrer</button></noscript>
                    </form>
                    <canvas id="pipelineChart" height="220"></canvas>
                    <p class="text-muted small mb-0 mt-2">
                        {% if filtreSprint %}
                            Vague sélectionnée — un prospect présent dans plusieurs vagues est compté dans chacune.
                        {% else %}
                            Toutes les vagues — un prospect présent dans plusieurs vagues est compté dans chacune.
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card mb-2">
                <div class="card-header">Prospects contactés par mois</div>
                <div class="card-body">
                    <div style="position: relative; height: 235px;">
                        <canvas id="contacteChart"></canvas>
                    </div>
                    <p class="text-muted small mb-0 mt-2">
                        Prospects passés à « contacté » par mois, à la date de leur premier contact.
                        Un prospect décontacté puis recontacté repart à zéro (la date est effacée à la
                        déconnexion) ; les prospects jamais contactés sont exclus.
                    </p>
                </div>
            </div>

            <div class="card mb-2">
                <div class="card-header">Qualification des prospects</div>
                <div class="card-body">
                    <div style="position: relative; height: 235px;">
                        <canvas id="qualificationChart"></canvas>
                    </div>
                    <p class="text-muted small mb-0 mt-2">
                        Prospects qualifiés (« Oui », « Hors produit » ou « Injoignable ») par mois, une courbe par produit.
                        Un prospect qualifié sur plusieurs produits apparaît dans chacune ; les
                        qualifications sans date sont exclues.
                    </p>
                </div>
            </div>

            <div class="card mb-2">
                <div class="card-header">Étape de pipeline des prospects</div>
                <div class="card-body">
                    <div style="position: relative; height: 235px;">
                        <canvas id="etapeChart"></canvas>
                    </div>
                    <p class="text-muted small mb-0 mt-2">
                        Changements de statut par mois, une courbe par étape — tous pipelines
                        confondus (une étape « Appel » regroupe tous les pipelines qui en ont
                        une). Tous les statuts sont comptés ; les changements sans date sont exclus.
                    </p>
                </div>
            </div>

            <div class="card mb-2">
                <div class="card-header">Actions réalisées</div>
                <div class="card-body">
                    <div style="position: relative; height: 235px;">
                        <canvas id="actionChart"></canvas>
                    </div>
                    <p class="text-muted small mb-0 mt-2">
                        Actions clôturées par mois, tous types confondus. Le mois est celui de la
                        date de réalisation ; le filtre « Affecté à » retient celles que
                        l'intervenant a réalisées.
                    </p>
                </div>
            </div>

        </div>

        <div class="col-md-3">

            <div class="card mb-2">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>En retard</span>
                    <span class="badge text-bg-danger">{{ kpi.actionsEnRetard }}</span>
                </div>
                <ul class="list-group list-group-flush">
                    {% for action in retard %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                {% if action.prospect %}<a href="{{ path(routeProspect, {id: action.prospect.id}) }}">{{ action.prospect.nom }}</a>{% endif %}
                                {% if action.contact %}<br><small class="text-muted">{{ action.contact.nomComplet }}</small>{% endif %}
                            </span>
                            <span class="badge text-bg-danger">{{ action.datePrevue ? action.datePrevue|date('d/m/Y') : '—' }}</span>
                        </li>
                    {% else %}
                        <li class="list-group-item text-muted">Aucune action en retard</li>
                    {% endfor %}
                </ul>
            </div>

            <div class="card mb-2">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Aujourd'hui</span>
                    <span class="badge text-bg-warning">{{ kpi.actionsAujourdhui }}</span>
                </div>
                <ul class="list-group list-group-flush">
                    {% for action in aujourdhui %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                {% if action.prospect %}<a href="{{ path(routeProspect, {id: action.prospect.id}) }}">{{ action.prospect.nom }}</a>{% endif %}
                                {% if action.contact %}<br><small class="text-muted">{{ action.contact.nomComplet }}</small>{% endif %}
                            </span>
                            <span class="badge text-bg-warning">{{ action.datePrevue ? action.datePrevue|date('d/m/Y') : '—' }}</span>
                        </li>
                    {% else %}
                        <li class="list-group-item text-muted">Aucune action à faire aujourd'hui</li>
                    {% endfor %}
                </ul>
            </div>

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>À venir</span>
                    <span class="badge text-bg-secondary">{{ kpi.actionsAVenir }}</span>
                </div>
                <ul class="list-group list-group-flush">
                    {% for action in avenir %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                {% if action.prospect %}<a href="{{ path(routeProspect, {id: action.prospect.id}) }}">{{ action.prospect.nom }}</a>{% endif %}
                                {% if action.contact %}<br><small class="text-muted">{{ action.contact.nomComplet }}</small>{% endif %}
                            </span>
                            <span class="badge text-bg-secondary">{{ action.datePrevue ? action.datePrevue|date('d/m/Y') : '—' }}</span>
                        </li>
                    {% else %}
                        <li class="list-group-item text-muted">Aucune action planifiée</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
{% endblock %}

{% block localscript %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var pipelineLabels = {{ etapes|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
            var pipelineData = {{ donneesPipeline|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
            var colors = ['#6c757d', '#0dcaf0', '#ffc107', '#adb5bd', '#198754', '#dc3545'];

            new Chart(document.getElementById('pipelineChart'), {
                type: 'bar',
                data: { labels: pipelineLabels, datasets: pipelineData.map(function(d, i) {
                    return { label: d.label, data: d.data, backgroundColor: colors[i % colors.length] };
                }) },
                options: { scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true, ticks: { precision: 0 } } } }
            });

            var qualificationMois = {{ moisQualifications|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
            var qualificationSeries = {{ seriesQualifications|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
            var qualificationCouleurs = ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#20c997', '#fd7e14', '#adb5bd'];

            new Chart(document.getElementById('qualificationChart'), {
                type: 'line',
                data: {
                    labels: qualificationMois,
                    datasets: qualificationSeries.map(function(d, i) {
                        var couleur = qualificationCouleurs[i % qualificationCouleurs.length];
                        return { label: d.label, data: d.data, borderColor: couleur, backgroundColor: couleur, tension: 0.3, pointRadius: 3 };
                    })
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });

            var contacteMois = {{ moisContactes|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
            var contacteSeries = {{ seriesContactes|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};

            new Chart(document.getElementById('contacteChart'), {
                type: 'line',
                data: {
                    labels: contacteMois,
                    datasets: contacteSeries.map(function(d, i) {
                        var couleur = qualificationCouleurs[i % qualificationCouleurs.length];
                        return { label: d.label, data: d.data, borderColor: couleur, backgroundColor: couleur, tension: 0.3, pointRadius: 3 };
                    })
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });

            var etapeMois = {{ moisEtapes|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
            var etapeSeries = {{ seriesEtapes|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};

            new Chart(document.getElementById('etapeChart'), {
                type: 'line',
                data: {
                    labels: etapeMois,
                    datasets: etapeSeries.map(function(d, i) {
                        var couleur = qualificationCouleurs[i % qualificationCouleurs.length];
                        return { label: d.label, data: d.data, borderColor: couleur, backgroundColor: couleur, tension: 0.3, pointRadius: 3 };
                    })
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });

            var actionMois = {{ moisRealisees|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
            var actionSeries = {{ seriesRealisees|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};

            new Chart(document.getElementById('actionChart'), {
                type: 'line',
                data: {
                    labels: actionMois,
                    datasets: actionSeries.map(function(d, i) {
                        var couleur = qualificationCouleurs[i % qualificationCouleurs.length];
                        return { label: d.label, data: d.data, borderColor: couleur, backgroundColor: couleur, tension: 0.3, pointRadius: 3 };
                    })
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        });
    </script>
{% endblock %}

{% block extramenu %}
    <a class="nav-link px-2" href="{{ path('app_user_reporting_pdf') }}" target="_blank" title="Imprimer"><i class="fas fa-print fa-2x"></i></a>
{% endblock %}
