{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <div class="alert alert-info">
        <i class="fas fa-circle-info"></i>
        Une vague regroupe les leads à traiter dans la même période.
    </div>

    <a href="{{ path(routesubmit) }}" class="btn btn-success mb-3">Ajouter</a>

    <div class="dataTable_wrapper">
        <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%" data-order-col="1" data-order-dir="desc">
            <thead>
            <tr>
                <th width="90px" class="no-sort">Action</th>
                <th>Numéro</th>
                <th>Libellé</th>
                <th>Pipeline</th>
                <th>Période</th>
                <th>Prospects</th>
                <th>Notes</th>
            </tr>
            </thead>
            <tbody>
                {% for ligne in lignes %}
                    {% set sprint = ligne.sprint %}
                    <tr>
                        <td>
                            <a href="{{ path(routeupdate, {id: sprint.id}) }}" title="Modifier"><i class="fas fa-file fa-2x"></i></a>
                            <a href="{{ path(routeprospect, {sprint: sprint.id}) }}" title="Prospects"><i class="fas fa-building fa-2x"></i></a>
                        </td>
                        <td>{{ sprint.numero }}</td>
                        <td>{{ sprint.libelle ?: '—' }}</td>
                        <td>
                            {% if sprint.pipeline %}
                                <span class="badge text-bg-primary">{{ sprint.pipeline }}</span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td data-order="{{ sprint.dateDebut ? sprint.dateDebut|date('Y-m-d') : '' }}">
                            {{ sprint.dateDebut ? sprint.dateDebut|date('d/m/Y') : '—' }}
                            →
                            {{ sprint.dateFin ? sprint.dateFin|date('d/m/Y') : '—' }}
                        </td>
                        <td>{{ ligne.prospects }}</td>
                        <td>{{ sprint.notes ?: '—' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
