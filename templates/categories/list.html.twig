{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <div class="mb-3">
        <a href="{{ path(routesubmit) }}" class="btn btn-success">Ajouter</a>
        <a href="{{ path('app_user_categories_bulk') }}" class="btn btn-primary mb-3 ms-1">Affecter en masse</a>
    </div>

    <div class="dataTable_wrapper">
        <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%">
            <thead>
            <tr>
                <th width="60px" class="no-sort">Action</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Prospects</th>
            </tr>
            </thead>
            <tbody>
                {% for category in categories %}
                    <tr>
                        <td>
                            <a href="{{ path(routeupdate, {id: category.id}) }}" title="Modifier"><i class="fas fa-file fa-2x"></i></a>
                            <a href="{{ path('app_user_prospects') }}?categorie={{ category.id }}" title="Prospects de cette catégorie"><i class="fas fa-building fa-2x"></i></a>
                        </td>
                        <td>{{ category.nom }}</td>
                        <td>{{ category.description|length > 100 ? category.description|slice(0, 100) ~ '…' : category.description ?: '—' }}</td>
                        <td>{{ category.prospects|length }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
