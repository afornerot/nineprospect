{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <div class="alert alert-info">
        <i class="fas fa-circle-info"></i>
        {{ total }} prospect(s) localisé(s) dans {{ lignes|length }} département(s).
        {% if sansDepartement > 0 %}
            <a href="{{ path('app_user_prospects', {sansdept: 1}) }}">{{ sansDepartement }} sans département connu.</a>
        {% endif %}
    </div>

    <div class="dataTable_wrapper">
        <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%" data-order-col="3" data-order-dir="desc">
            <thead>
            <tr>
                <th width="90px" class="no-sort">Action</th>
                <th>Département</th>
                <th>Région</th>
                <th>Prospects</th>
                <th>Part</th>
            </tr>
            </thead>
            <tbody>
                {% for ligne in lignes %}
                    <tr>
                        <td>
                            <a href="{{ path('app_user_prospects', {departement: ligne.id}) }}" title="Prospects"><i class="fas fa-building fa-2x"></i></a>
                        </td>
                        <td>{{ ligne.numero }} — {{ ligne.nom }}</td>
                        <td>{{ ligne.region ?: '—' }}</td>
                        <td>{{ ligne.total }}</td>
                        <td>
                            <div class="progress" role="progressbar" aria-valuenow="{{ ligne.total }}" aria-valuemin="0" aria-valuemax="{{ total }}">
                                <div class="progress-bar" style="width: {{ total > 0 ? (ligne.total / total * 100)|round(1) : 0 }}%"></div>
                            </div>
                            <small>{{ total > 0 ? (ligne.total / total * 100)|round(1) : 0 }} %</small>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
