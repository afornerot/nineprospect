{% extends 'base.html.twig' %}

{% block title %}Page introuvable{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-5">
                    <h1 class="display-1 text-muted mb-4">404</h1>
                    <h2 class="h3 mb-3">Page introuvable</h2>
                    <p class="text-muted mb-4">{{ message|default('La page demandée est introuvable.') }}</p>
                    <a href="https://www.cadoles.com" class="btn btn-primary">
                        <i class="fas fa-home me-2"></i>Retour à l'accueil
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
