{% extends 'base.html.twig' %}

{% block title %}Inscription réussie - {{ campagne.nom }}{% endblock %}

{% block localstyle %}
{% include 'public/style.html.twig' %}
{% endblock %}

{% block body %}
<div class="app-content public-contact">
<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 style="color: #ff974a; font-size: 1.5rem;">{{ cible.titre }}</h1>
            <p class="mt-2" style="color: rgba(255,255,255,0.8); font-size: 0.9rem;">
                <i class="fas fa-check-circle me-1" style="color: #6fc7e2;"></i>
                Merci pour votre inscription !
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header" style="background-color: rgba(111, 199, 226, 0.2); border-bottom: 1px solid rgba(111, 199, 226, 0.3);">
                    <h2 class="h5 mb-0" style="color: #6fc7e2;">Choisir une cible</h2>
                </div>
                <div class="card-body">
                    <form id="cible-form" method="get">
                        <div class="mb-3">
                            <label for="autre-cible" class="form-label">Sélectionnez une cible</label>
                            <select class="form-control" id="autre-cible" name="cibleSlug">
                                {% for c in allCibles %}
                                    <option value="{{ c.slug ?: c.id }}" {% if c.id == cible.id %}selected{% endif %}>{{ c.titre }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </form>
                </div>
            </div>

            {% if not prospectCible %}
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" action="{{ path('app_public_contact_success', {campagneSlug: campagne.slug, cibleSlug: cible.slug}) }}">
                        <input type="hidden" name="linkCible" value="{{ cible.id }}">
                        <button type="submit" class="btn w-100" style="background-color: #ff974a; color: #0f2f3f; border-radius: 9999px;">
                            <i class="fas fa-link me-2"></i>Afficher les documents
                        </button>
                    </form>
                </div>
            </div>
            {% endif %}

            {% if prospectCible or show_docs|default(false) %}
            <div class="card mb-4" id="documents-card">
                <div class="card-header" style="background-color: rgba(255, 151, 74, 0.2); border-bottom: 1px solid rgba(255, 151, 74, 0.3);">
                    <h2 class="h5 mb-0" style="color: #ff974a;">Documents disponibles</h2>
                </div>
                <div class="card-body">
                    {{ render(path('bninefiles_files', {domain: 'cible', id: cible.id, editable: 0})) }}
                </div>
            </div>
            {% endif %}
        </div>

        <div class="col-lg-6">
            <div class="cible-description" style="font-size: 1.1rem; line-height: 1.6; color: rgba(255,255,255,0.9);">
                {% if cible.description %}
                    {{ cible.description|markdown_to_html }}
                {% else %}
                    <p class="text-white-50">Pas de description disponible.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const cibleSelect = document.getElementById('autre-cible');
    
    cibleSelect.addEventListener('change', function() {
        const cibleSlug = this.value;
        if (cibleSlug) {
            window.location.href = '/contact/{{ campagne.slug }}/' + cibleSlug + '/success';
        }
    });
});
</script>
{% endblock %}
