{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <div class="mb-3">
        <a href="{{ path(routesubmit) }}" class="btn btn-success">Ajouter</a>
        <a href="{{ path('app_user_produits_bulk') }}" class="btn btn-primary ms-1">Affecter en masse</a>
    </div>

    <div class="dataTable_wrapper">
        <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%">
            <thead>
            <tr>
                <th width="60px" class="no-sort">Action</th>
                <th>Titre</th>
                <th>Description</th>
                <th>Prospects</th>
                <th>Form Contact</th>
            </tr>
            </thead>
            <tbody>
                {% for produit in produits %}
                    <tr>
                        <td>
                            <a href="{{ path(routeupdate, {id: produit.id}) }}" title="Modifier"><i class="fas fa-file fa-2x"></i></a>
                            <a href="{{ path(routeprospects, {produit: produit.id}) }}" title="Prospects de ce produit"><i class="fas fa-building fa-2x"></i></a>
                        </td>
                        <td>{{ produit.titre }}</td>
                        <td>{{ produit.description|length > 100 ? produit.description|slice(0, 100) ~ '…' : produit.description ?: '—' }}</td>
                        <td>{{ produit.prospectProduits|length }}</td>
                        <td>
                            {% for campagne in campagnes %}
                                {% set contactUrl = url('app_public_contact', {campagneSlug: campagne.slug ?: campagne.externalId, produitSlug: produit.slug ?: produit.id})|replace({'http://': 'https://'}) %}
                                <a href="{{ contactUrl }}" target="_blank" class="btn btn-sm btn-outline-primary mb-1 me-1" title="{{ campagne.nom }}">
                                    {{ campagne.nom }}
                                </a>
                            {% endfor %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
