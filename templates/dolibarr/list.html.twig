{% extends 'base.html.twig' %}

{% block title %} = {{title}}{% endblock %}

{% block body %}
    <h1>{{title}}</h1>

    <p class="text-muted">
        Devis et commandes Dolibarr synchronisés dans nineprospect, avec le produit associé ou à associer.
    </p>

    <div class="dataTable_wrapper">
        <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%" data-order-col="2" data-order-dir="desc">
            <thead>
            <tr>
                <th width="90px" class="no-sort">Type</th>
                <th>Référence</th>
                <th>Date</th>
                <th>Statut</th>
                <th class="text-end">Montant HT</th>
                <th>Prospect</th>
                <th>Produit associé</th>
            </tr>
            </thead>
            <tbody>
                {% for doc in lignes %}
                    <tr>
                        <td><span class="badge text-bg-{{ doc.type == 'Devis' ? 'primary' : 'success' }}">{{ doc.type }}</span></td>
                        <td>
                            {% if doc.url %}
                                <a href="{{ doc.url }}" target="_blank" rel="noopener">{{ doc.ref }}</a>
                            {% else %}
                                {{ doc.ref }}
                            {% endif %}
                        </td>
                        <td data-order="{{ doc.dateDoc ? doc.dateDoc|date('Y-m-d') : '' }}">{{ doc.dateDoc ? doc.dateDoc|date('d/m/Y') : '—' }}</td>
                        <td><span class="badge text-bg-{{ doc.statutCouleur }}">{{ doc.statutLabel }}</span></td>
                        <td class="text-end text-nowrap" data-order="{{ doc.totalHt ?? 0 }}">{{ doc.totalHt is not null ? doc.totalHt|number_format(2, ',', ' ') ~ ' €' : '—' }}</td>
                        <td>
                            {% if doc.prospect %}
                                <a href="{{ path('app_user_prospects_show', {id: doc.prospect.id}) }}">{{ doc.prospect.nom }}</a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            {% if doc.produit %}
                                <span class="badge text-bg-info">{{ doc.produit.titre }}</span>
                            {% else %}
                                <span class="badge text-bg-warning">Non associé</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-muted">Aucun devis ni commande synchronisé.</td></tr>
                {% endfor %}
                </tbody>
        </table>
    </div>
{% endblock %}
