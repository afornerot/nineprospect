{% extends 'base.html.twig' %}

{% block title %} = {{title}}{% endblock %}

{% block body %}
    <h1>{{title}}</h1>

    <div class="position-relative">
        {%if mode=="update" %}{% include 'include/delete_button.html.twig' with {route: routedelete, id: form.vars.value.id, tokenId: 'delete-objective' ~ form.vars.value.id, classes: 'delete-abs'} %}{%endif%}

        {{ form_start(form) }}

        {{ form_widget(form.submit) }}
        <a href="{{ retour }}" class="btn btn-secondary ms-1">Annuler</a>

        {% include('include/error.html.twig') %}

        <div class="card mt-3">
            <div class="card-header">Informations</div>
            <div class="card-body">
                {{ form_row(form.startDate) }}
                {{ form_row(form.endDate) }}
                {{ form_row(form.produit) }}
                {{ form_row(form.type) }}
                {{ form_row(form.target) }}
            </div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block localscript %}
    <script>
        $(document).ready(function() {
            $("#objective_startDate").focus();
        });
    </script>
{% endblock %}
