{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <p class="text-muted">
        Recherchez un tiers Dolibarr, sélectionnez un résultat, puis créez
        un prospect pré-rempli avec ses données (SIREN, SIRET, adresse,
        email, téléphone) et déjà lié au tiers.
        Un tiers Dolibarr ne peut être lié qu'à un seul prospect.
    </p>

    {% if not actif %}
        <div class="alert alert-warning">
            <i class="fas fa-triangle-exclamation"></i>
            Intégration Dolibarr désactivée (DOLIBARR_URL absent).
        </div>
    {% endif %}

    <form method="get" action="{{ path('app_user_prospects_from_dolibarr') }}" class="mb-4">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="search"
                   name="q"
                   value="{{ query }}"
                   class="form-control"
                   placeholder="Nom du tiers…"
                   autocomplete="off"
                   autofocus>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-magnifying-glass me-1"></i>Rechercher
            </button>
        </div>
        {% if apiError %}
            <div class="alert alert-warning mt-3 mb-0">
                <i class="fas fa-triangle-exclamation"></i>
                API indisponible : {{ apiError }}. Réessayez plus tard.
            </div>
        {% endif %}
    </form>

    {% if query is empty %}
        <p class="text-muted small">
            <i class="fas fa-info-circle"></i>
            Saisissez un critère ci-dessus pour afficher les résultats.
        </p>
    {% elseif rows is empty and apiError is null %}
        <div class="alert alert-warning">
            <i class="fas fa-info-circle"></i>
            Aucun tiers correspondant trouvé dans Dolibarr.
        </div>
    {% else %}
        <form id="js-from-dolibarr-form" data-create-url="{{ createUrl }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf }}">

            <div class="list-group">
                {% for row in rows %}
                    {% set lie = row.existingId is not null %}
                    <label class="list-group-item" {% if not lie %}style="cursor: pointer;"{% endif %}>
                        <div class="d-flex align-items-start gap-3">
                            <input type="radio"
                                   name="thirdpartyId"
                                   value="{{ row.id }}"
                                   class="form-check-input flex-shrink-0 mt-1"
                                   {% if lie %}disabled{% elseif loop.first %}checked{% endif %}>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>{{ row.nom ?: '—' }}</strong>
                                        {% if row.alias %}<span class="text-muted small">({{ row.alias }})</span>{% endif %}<br>
                                        <span class="text-muted small">
                                            {{ row.adresse ?: '—' }}<br>
                                            {{ row.codePostal ?: '—' }} {{ row.ville ?: '' }}
                                        </span>
                                    </div>
                                    <div class="text-end small text-muted">
                                        <span class="badge text-bg-secondary">Tiers {{ row.id }}</span><br>
                                        {% if lie %}
                                            <span class="badge text-bg-danger mt-1">Déjà lié (prospect {{ row.existingId }})</span>
                                        {% endif %}
                                        {% if row.siren %}<span class="d-block mt-1">SIREN {{ row.siren }}</span>{% endif %}
                                        {% if row.email %}<span class="d-block">{{ row.email }}</span>{% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </label>
                {% endfor %}
            </div>
        </form>
    {% endif %}

    <div class="d-flex justify-content-between mt-3">
        <a href="{{ path(routeList) }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Retour à la liste
        </a>
        {% if rows is not empty %}
            <button type="button" class="btn btn-success js-from-dolibarr-create">
                <i class="fas fa-plus me-1"></i>Créer ce prospect
            </button>
        {% endif %}
    </div>
{% endblock %}

{% block localscript %}
    {{ parent() }}
    <script>
        (function () {
            function ready(fn) {
                if (document.readyState !== 'loading') fn();
                else document.addEventListener('DOMContentLoaded', fn);
            }
            ready(function () {
                const $btn = document.querySelector('.js-from-dolibarr-create');
                if (!$btn) return;
                $btn.addEventListener('click', function () {
                    const form = document.getElementById('js-from-dolibarr-form');
                    if (!form) return;
                    const tiers = form.querySelector('input[name="thirdpartyId"]:checked');
                    if (!tiers) { alert('Sélectionnez un résultat.'); return; }
                    const csrf = form.querySelector('input[name="_csrf_token"]').value;
                    const url = form.getAttribute('data-create-url');
                    $btn.disabled = true;
                    fetch(url, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                            'Origin': window.location.origin,
                        },
                        body: JSON.stringify({ thirdpartyId: tiers.value, csrf_token: csrf }),
                    }).then(function (resp) {
                        return resp.json().then(function (data) {
                            return { ok: resp.ok, status: resp.status, data: data };
                        });
                    }).then(function (r) {
                        if (!r.ok || !r.data.ok) {
                            const msg = (r.data && r.data.error) ? r.data.error : ('Erreur ' + r.status);
                            if (r.data && r.data.existingRedirect) {
                                if (confirm(msg + '\n\nOuvrir le prospect existant ?')) {
                                    window.location.href = r.data.existingRedirect;
                                    return;
                                }
                            } else {
                                alert(msg);
                            }
                            return;
                        }
                        window.location.href = r.data.redirect || window.location.href;
                    }).catch(function () {
                        alert('Erreur réseau. Veuillez réessayer.');
                    }).finally(function () {
                        $btn.disabled = false;
                    });
                });
            });
        })();
    </script>
{% endblock %}
