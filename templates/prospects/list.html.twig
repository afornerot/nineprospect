{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <form method="get" class="d-flex flex-wrap gap-2 align-items-end mb-3 w-100">
        <div class="flex-grow-1" style="min-width: 160px;">
            <label class="form-label" for="filtre-q">Recherche</label>
            <input type="text" class="form-control" id="filtre-q" name="q" value="{{ filtres.recherche }}" placeholder="Nom, ville, email...">
        </div>
        <div class="flex-grow-1" style="min-width: 160px;">
            <label class="form-label" for="filtre-campagne">Campagne</label>
            <select class="form-select" id="filtre-campagne" name="campagne">
                <option value="">Toutes</option>
                {% for campagne in campagnes %}
                    <option value="{{ campagne.id }}" {% if filtres.campagne == campagne.id %}selected{% endif %}>{{ campagne.libelle }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="flex-grow-1" style="min-width: 140px;">
            <label class="form-label" for="filtre-sprint">Vague</label>
            <select class="form-select" id="filtre-sprint" name="sprint">
                <option value="">Toutes</option>
                {% for sprint in sprints %}
                    <option value="{{ sprint.id }}" {% if filtres.sprint == sprint.id %}selected{% endif %}>{{ sprint }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="flex-grow-1" style="min-width: 150px;">
            <label class="form-label" for="filtre-utilisateur">Affecté à</label>
            <select class="form-select" id="filtre-utilisateur" name="utilisateur">
                <option value="">Tous</option>
                {% for utilisateur in utilisateurs %}
                    <option value="{{ utilisateur.id }}" {% if filtres.userId == utilisateur.id %}selected{% endif %}>{{ utilisateur.username }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="flex-grow-1" style="min-width: 130px;">
            <label class="form-label" for="filtre-contacte">Contacté</label>
            <select class="form-select" id="filtre-contacte" name="contacte">
                <option value="">Tous</option>
                <option value="oui" {% if filtres.contacte == 'oui' %}selected{% endif %}>Oui</option>
                <option value="non" {% if filtres.contacte == 'non' %}selected{% endif %}>Non</option>
            </select>
        </div>
        <div class="flex-grow-1" style="min-width: 160px;">
            <label class="form-label" for="filtre-produit">Produit</label>
            <select class="form-select" id="filtre-produit" name="produit">
                <option value="">Toutes</option>
                {% for produit in produits %}
                    <option value="{{ produit.id }}" {% if filtres.produit == produit.id %}selected{% endif %}>{{ produit.titre }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="flex-grow-1" style="min-width: 160px;">
            <label class="form-label" for="filtre-cible">Cible</label>
            <select class="form-select" id="filtre-cible" name="cible">
                <option value="">Toutes</option>
                {% for cible in cibles %}
                    <option value="{{ cible.id }}" {% if filtres.cible == cible.id %}selected{% endif %}>{{ cible.nom }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="flex-grow-1" style="min-width: 140px;">
            <label class="form-label" for="filtre-qualifie">Qualifié</label>
            <select class="form-select" id="filtre-qualifie" name="qualifie">
                <option value="">Tous</option>
                <option value="oui" {% if filtres.qualifie == 'oui' %}selected{% endif %}>Oui</option>
                <option value="non" {% if filtres.qualifie == 'non' %}selected{% endif %}>Non</option>
                <option value="horsproduit" {% if filtres.qualifie == 'horsproduit' %}selected{% endif %}>Hors produit</option>
                <option value="injoignable" {% if filtres.qualifie == 'injoignable' %}selected{% endif %}>Injoignable</option>
            </select>
        </div>
        <div class="flex-grow-1" style="min-width: 140px;">
            <label class="form-label" for="filtre-statut">Statut action</label>
            <select class="form-select" id="filtre-statut" name="statut">
                <option value="">Tous</option>
                <option value="retard" {% if filtres.statut == 'retard' %}selected{% endif %}>En retard</option>
                <option value="aujourdhui" {% if filtres.statut == 'aujourdhui' %}selected{% endif %}>Aujourd'hui</option>
                <option value="avenir" {% if filtres.statut == 'avenir' %}selected{% endif %}>À venir</option>
                <option value="faites" {% if filtres.statut == 'faites' %}selected{% endif %}>Réalisée</option>
            </select>
        </div>
        <div class="flex-shrink-0"> 
            <button type="submit" class="btn btn-primary">Filtrer</button>
        </div>
        <div class="flex-shrink-0">
            <a href="{{ path('app_user_prospects') }}" class="btn btn-secondary">Réinitialiser</a>
        </div>
    </form>

    <a href="{{ path(routesubmit) }}" class="btn btn-success mb-3">Ajouter</a>
    <a href="{{ path('app_user_prospects_from_annuaire') }}" class="btn btn-outline-success mb-3 ms-1">
        <i class="fas fa-magnifying-glass me-1"></i>Créer depuis l'Annuaire
    </a>
    <a href="{{ path('app_user_produits_import') }}" class="btn btn-outline-primary mb-3 ms-1">
        <i class="fas fa-file-import me-1"></i>Importer
    </a>

    <div class="dataTable_wrapper">
        <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%" data-order-col="1" data-order-dir="asc">
            <thead>
            <tr>
                <th width="90px" class="no-sort">Action</th>
                <th>Prospect</th>
                <th width="150px">Contact principal</th>
                <th width="150px">Téléphone</th>
                <th width="80px">Vague</th>
                <th>Pipeline</th>
                <th width="80px">Contacté</th>
                <th width="180px">Produit</th>
                <th width="100px">Prc Action</th>
            </tr>
            </thead>
            <tbody>
                {% for prospect in prospects %}
                    {% set contact = prospect.contactPrincipal %}
                    {% set liens = prospect.sprints|sort((a, b) => a.sprint.numero <=> b.sprint.numero) %}
                    {% set courant = liens|last %}
                    <tr id="prospect-{{ prospect.id }}">
                        <td>
                            <a href="{{ path(routeshow, {id: prospect.id}) }}" title="Fiche"><i class="fas fa-eye fa-2x"></i></a>
                            <a href="{{ path(routeupdate, {id: prospect.id}) }}" title="Modifier"><i class="fas fa-file fa-2x"></i></a>
                        </td>
                        <td>
                            <a href="{{ path(routeshow, {id: prospect.id}) }}">{{ prospect.nom }}</a>
                            {% if prospect.email %}
                                <br><small class="text-muted"><a href="mailto:{{ prospect.email }}">{{ prospect.email }}</a></small>
                            {% endif %}
                            {% if prospect.ville or prospect.codePostal or prospect.departement %}
                                <br><small class="text-muted">{{- prospect.ville -}}
                                    {%- if prospect.codePostal %} ({{ prospect.codePostal }}){% endif -%}
                                    {%- if prospect.departement %} — {{ prospect.departement }}{% endif -%}
                                </small>
                            {% endif %}
                        </td>
                        <td>
                            {% if contact %}
                                {{ contact.nomComplet }}<br><small class="text-muted">{% if contact.email %}<a href="mailto:{{ contact.email }}">{{ contact.email }}</a>{% else %}—{% endif %}</small>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% set telephone = contact and contact.telephone ? contact.telephone : prospect.telephone %}
                            {% if telephone %}
                                <a href="tel:{{ telephone|replace({' ': ''}) }}">{{ telephone }}</a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% for lien in liens %}<span class="badge text-bg-secondary me-1">{{ lien.sprint.numero }}</span>{% else %}<span class="text-muted">—</span>{% endfor %}
                        </td>
                        <td>
                            {% if courant and courant.sprint.pipeline %}
                                {% for etape in courant.sprint.pipeline.etapes %}
                                    {% set valeur = courant.statutPour(etape) %}
                                    <button type="button" class="badge text-bg-{{ pipeline_color(valeur) }} js-cycle-etape" data-prospect="{{ prospect.id }}" data-etape="{{ etape.id }}" data-csrf="{{ csrf_token('cycle-etape-prospect-' ~ prospect.id) }}" title="{{ pipeline_label(valeur) }}" data-static-label="{{ etape.nom }}">{{ etape.nom }}</button>
                                {% endfor %}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="form-check form-switch js-toggle-contacte-wrapper" data-action-id="{{ prospect.id }}" data-csrf="{{ csrf_token('toggle-contacte-prospect' ~ prospect.id) }}" data-contacte="{{ prospect.contacte is same as(true) ? '1' : '0' }}">
                                <input type="checkbox" class="form-check-input js-toggle-contacte" role="switch" {% if prospect.contacte %}checked{% endif %} aria-label="Contacté" title="Contacté{% if prospect.contactePar %} par {{ prospect.contactePar.username }}{% endif %}">
                            </div>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                {% for pc in prospect.prospectProduits %}
                                    <button type="button" class="badge text-bg-{{ qualifie_color(pc.qualifie) }} js-cycle-produit" data-prospect="{{ prospect.id }}" data-produit="{{ pc.produit.id }}" data-csrf="{{ csrf_token('toggle-produit-prospect-' ~ prospect.id ~ '-' ~ pc.produit.id) }}" title="{{ qualifie_label(pc.qualifie) }}">
                                        {{ pc.produit.titre }}
                                    </button>
                                {% endfor %}
                                {% set produitsDisponibles = [] %}
                                {% for produit in produits %}
                                    {% set dejaLiee = false %}
                                    {% for pc in prospect.prospectProduits %}
                                        {% if pc.produit.id == produit.id %}
                                            {% set dejaLiee = true %}
                                        {% endif %}
                                    {% endfor %}
                                    {% if not dejaLiee %}
                                        {% set produitsDisponibles = produitsDisponibles|merge([produit]) %}
                                    {% endif %}
                                {% endfor %}
                                {% if produitsDisponibles|length > 0 %}
                                <div class="dropdown">
                                    <button type="button" class="btn btn-sm btn-outline-secondary js-add-produit dropdown-toggle" data-bs-toggle="dropdown" data-prospect="{{ prospect.id }}" aria-expanded="false" title="Ajouter un produit">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        {% for produit in produitsDisponibles %}
                                            <li>
                                                <a class="dropdown-item js-link-produit" href="#" data-prospect="{{ prospect.id }}" data-produit="{{ produit.id }}" data-csrf="{{ csrf_token('add-produit-prospect-' ~ prospect.id ~ '-' ~ produit.id) }}">
                                                    {{ produit.titre }}
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                                {% endif %}
                            </div>
                        </td>
                        <td class="text-center">
                            {% set actionSuivi = prospect.derniereAction %}
                            {% if actionSuivi %}
                                <a href="{{ path('app_user_actions_update', {id: actionSuivi.id}) }}" title="{{ actionSuivi.typeAction ?: '—' }}">
                                    <span class="badge text-bg-{{ actionSuivi.statutColor }} d-block">{{ actionSuivi.statutLabel }}</span>
                                    {{ actionSuivi.dateAffichee ? actionSuivi.dateAffichee|date('d/m/Y') : '—' }}
                                </a>
                            {% else %}
                                <a href="{{ path('app_user_actions_submit', {prospect: prospect.id}) }}" class="btn btn-sm btn-outline-primary" title="Créer une action"><i class="fas fa-plus"></i></a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
