{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <div class="position-relative">
        {% if routedelete is defined and routedelete %}{% include 'include/delete_button.html.twig' with {route: routedelete, id: form.vars.value.id, tokenId: 'delete-prospect' ~ form.vars.value.id, classes: 'delete-abs'} %}{% endif %}

        {{ form_start(form) }}

        {{ form_widget(form.submit) }}
        {% if redirect is defined and redirect %}
            <a href="{{ redirect }}" class="btn btn-secondary ms-1">Annuler</a>
        {% else %}
            <a href="{{ path(routecancel) }}" class="btn btn-secondary ms-1">Annuler</a>
        {% endif %}

        {% if routeshow is defined and routeshow and form.vars.value.id %}
            <a href="{{ path(routeshow, {id: form.vars.value.id}) }}" class="btn btn-secondary ms-1">Voir la fiche</a>
        {% endif %}

        {% include('include/error.html.twig') %}

        {% if prospect is defined and prospect and prospect.anomalie %}
            <div class="alert alert-danger mt-3">
                <i class="fas fa-triangle-exclamation"></i>
                Anomalies signalées à l'import : {{ prospect.anomalieMotif }}
            </div>
        {% endif %}

        <div class="row">
            <div class="col-md-4 mx-auto">
                <div class="card mt-3">
                    <div class="card-header">Identification</div>
                    <div class="card-body">
                        <div class="row">
                            {% if form.logo is defined %}
                                <div class="col-md-12">
                                    {{ form_row(form.logo) }}
                                </div>
                            {% endif %}

                            <div class="col-md-12">{{ form_row(form.nom) }}</div>

                            <div class="col-md-12">{{ form_row(form.email) }}</div>
                            <div class="col-md-12">{{ form_row(form.telephone) }}</div>

                            <div class="col-md-12">{{ form_row(form.siteUrl) }}</div>
                            <div class="col-md-12">{{ form_row(form.linkedinUrl) }}</div>
                        </div>
                        <div class="row">
                            <div class="col-md-6"></div>
                        </div>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">Données entreprise</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.siren) }}</div>
                            <div class="col-md-6">{{ form_row(form.siret) }}</div>
                            <div class="col-md-6">{{ form_row(form.naf) }}</div>
                            <div class="col-md-6">{{ form_row(form.rcsRm) }}</div>
                            <div class="col-md-6">{{ form_row(form.numTva) }}</div>
                            <div class="col-md-6">{{ form_row(form.idDolibarr) }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mx-auto">
                <div class="card mt-3">
                    <div class="card-header">Coordonnées</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">{{ form_row(form.adresse) }}</div>
                            <div class="col-md-3">{{ form_row(form.codePostal) }}</div>
                            <div class="col-md-9">{{ form_row(form.ville) }}</div>                            <div class="col-md-9">{{ form_row(form.departement) }}</div>
                            <div class="col-md-3">{{ form_row(form.pays) }}</div>
                            <div class="col-md-6">{{ form_row(form.latitude) }}</div>
                            <div class="col-md-6">{{ form_row(form.longitude) }}</div>
                        </div>
                    </div>
                </div>

            <div class="card mt-3">
                <div class="card-header">
                    Pipeline
                    {% if vagueCourante is defined and vagueCourante %}
                        — vague {{ vagueCourante.sprint.numero }}{% if vagueCourante.sprint.libelle %} ({{ vagueCourante.sprint.libelle }}){% endif %}
                        {% if vagueCourante.sprint.pipeline %}<span class="text-muted fw-normal">{{ vagueCourante.sprint.pipeline }}</span>{% endif %}
                    {% endif %}
                    {% if etapes is not defined or etapes is empty %}
                        <span class="text-muted fw-normal">sélectionnez au moins une vague ci-dessus pour enregistrer un pipeline</span>
                    {% endif %}
                </div>
                <div class="card-body">
                    {% if etapes is defined and etapes is not empty %}
                        <div class="row">
                            {% for etape in etapes %}
                                <div class="col-md-6">{{ form_row(form['etape' ~ etape.id]) }}</div>
                                <div class="col-md-6">{{ form_row(form['dateEtape' ~ etape.id]) }}</div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

            </div>

            <div class="col-md-4 mx-auto">
                <div class="card mt-3">
                    <div class="card-header">Suivi commercial</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">{{ form_row(form.contacte) }}</div>
                            <div class="col-md-12">{{ form_row(form.datePremierContact) }}</div>
                            <div class="col-md-6">{{ form_row(form.campagne) }}</div>
                            <div class="col-md-6">{{ form_row(form.sprints) }}</div>
                            <div class="col-md-12">{{ form_row(form.users) }}</div>
                            <div class="col-md-12">{{ form_row(form.notes) }}</div>
                        </div>
                    </div>
                </div>
            </div>

            {{ form_end(form) }}

            <div class="col-md-12">
                <div class="card mt-3">
                    <div class="card-header">Cibles</div>
                    <div class="card-body">
                        {% if formCibles %}
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th style="width: 25%">Cible</th>
                                        <th style="width: 65%">Qualification</th>
                                        <th style="width: 10%"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for linkId, formCible in formCibles %}
                                        <tr>
                                            <td style="vertical-align: middle">{{ formCible.vars.data.cible|default('—') }}</td>
                                            <td style="vertical-align: middle">
                                                <form method="post" action="{{ path('app_user_prospects_cibles_update', {prospectId: prospect.id, linkId: linkId}) }}" class="d-inline mb-0">
                                                    <div class="d-flex gap-2 align-items-center">
                                                        <div style="width: 30%">{{ form_widget(formCible.qualifie, {'attr': {'class': 'form-select form-select-sm'}}) }}</div>
                                                        <div style="width: 60%">{{ form_widget(formCible.qualification, {'attr': {'class': 'form-control form-control-sm'}}) }}</div>
                                                        <div style="width: 10%">
                                                            <button type="submit" class="btn btn-sm btn-primary w-100" title="Enregistrer"><i class="fa-solid fa-floppy-disk"></i></button>
                                                        </div>
                                                    </div>
                                                </form>
                                            </td>
                                            <td style="vertical-align: middle">
                                                <form method="post" action="{{ path('app_user_prospects_cibles_delete', {prospectId: prospect.id, linkId: linkId}) }}" class="d-inline mb-0" onsubmit="return confirm('Confirmez-vous la suppression de cette cible ?')">
                                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('prospect-cible' ~ linkId) }}">
                                                    <button type="submit" class="btn btn-sm btn-danger" title="Supprimer"><i class="fa-solid fa-trash-can"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% endif %}

                        <hr>

                        <div class="row g-2 align-items-end">
                            <div class="col">
                                {{ form_start(formAjoutCible) }}
                                <div class="d-flex gap-2">
                                    <div style="width: 25%">{{ form_widget(formAjoutCible.cible) }}</div>
                                    <div style="width: 65%">
                                        <div class="d-flex gap-2">
                                            <div style="width: 30%">{{ form_widget(formAjoutCible.qualifie, {'attr': {'class': 'form-select form-select-sm'}}) }}</div>
                                            <div style="width: 60%">{{ form_widget(formAjoutCible.qualification, {'attr': {'class': 'form-control form-control-sm'}}) }}</div>
                                            <div style="width: 10%">
                                                <button type="submit" class="btn btn-success w-100" title="Ajouter"><i class="fa-solid fa-plus me-1"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {{ form_end(formAjoutCible) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% if mode is defined and mode == 'update' %}
                <div class="card mt-3">
                    <div class="card-header">Documents</div>
                    <div class="card-body p-0">
                        {{ render(path('bninefiles_files', {domain: 'prospect_file', id: form.vars.value.id, editable: 1})) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block localscript %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $("#prospect_nom").focus();
        });
    </script>
{% endblock %}
