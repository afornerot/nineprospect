{# Modale de liaison d'un prospect à un tiers Dolibarr (lecture seule).
   Injectée dans la fiche prospect via fetch JS
   (`/user/prospects/{id}/dolibarr/search`). Le POST `/dolibarr/link`
   écrit `prospect.id_dolibarr` après revalidation du tiers côté serveur. #}

<div class="modal fade" id="js-dolibarr-modal-{{ prospect.id }}" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-building me-2"></i>
                    Lier à un tiers Dolibarr
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                {% if not actif %}
                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-triangle-exclamation"></i>
                        Intégration Dolibarr non configurée (<code>DOLIBARR_URL</code> /
                        <code>DOLIBARR_API_KEY</code>). La recherche est indisponible.
                    </div>
                {% else %}
                    <p class="text-muted small mb-3">
                        Recherche dans les tiers Dolibarr par nom, code client ou code fournisseur.
                        La liaison est un simple lien : aucune donnée n'est écrite dans Dolibarr.
                        {% if prospect.idDolibarr %}
                            <br>Prospect actuellement lié au tiers
                            <strong>#{{ prospect.idDolibarr }}</strong>.
                        {% endif %}
                        {% if apiError %}
                            <br><span class="text-warning">
                                <i class="fas fa-triangle-exclamation"></i>
                                Dolibarr indisponible : {{ apiError }}.
                            </span>
                        {% endif %}
                    </p>

                    <form id="js-dolibarr-search-{{ prospect.id }}"
                          data-search-url="{{ searchUrl }}"
                          class="mb-3">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="search"
                                   name="q"
                                   value="{{ query }}"
                                   class="form-control"
                                   placeholder="Raison sociale, code client, code fournisseur…"
                                   autocomplete="off">
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="fas fa-magnifying-glass me-1"></i>Rechercher
                            </button>
                        </div>
                    </form>

                    {% if rows is empty and apiError is null and query %}
                        <div class="alert alert-warning">
                            <i class="fas fa-info-circle"></i>
                            Aucun tiers Dolibarr ne correspond à « {{ query }} ».
                        </div>
                    {% endif %}

                    <form id="js-dolibarr-form-{{ prospect.id }}"
                          data-link-url="{{ linkUrl }}"
                          {% if rows is empty %}class="d-none"{% endif %}>
                        <input type="hidden" name="_csrf_token" value="{{ csrf }}">
                        <input type="hidden" name="prospectId" value="{{ prospect.id }}">

                        {% if rows is not empty %}
                            <div class="list-group">
                                {% for row in rows %}
                                    <label class="list-group-item js-dolibarr-option" style="cursor: pointer;">
                                        <div class="d-flex align-items-start gap-3">
                                            <input type="radio"
                                                   name="thirdpartyId"
                                                   value="{{ row.id }}"
                                                   class="form-check-input flex-shrink-0 mt-1"
                                                   {% if prospect.idDolibarr and prospect.idDolibarr == row.id %}checked{% elseif loop.first and not prospect.idDolibarr %}checked{% endif %}>
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <strong>{{ row.nom ?: '—' }}</strong>
                                                        {% if row.alias %}<span class="text-muted">({{ row.alias }})</span>{% endif %}
                                                        <br>
                                                        <span class="text-muted small">
                                                            {{ row.adresse ?: '—' }}<br>
                                                            {{ row.codePostal ?: '—' }} {{ row.ville ?: '' }}
                                                        </span>
                                                    </div>
                                                    <div class="text-end small text-muted">
                                                        <span class="badge text-bg-secondary">Dolibarr #{{ row.id }}</span>
                                                        {% for type in row.types %}
                                                            <span class="badge text-bg-info">{{ type }}</span>
                                                        {% endfor %}
                                                        {% if row.codeClient %}<span class="d-block mt-1">Client {{ row.codeClient }}</span>{% endif %}
                                                        {% if row.codeFournisseur %}<span class="d-block">Fournisseur {{ row.codeFournisseur }}</span>{% endif %}
                                                        {% if row.siren %}<span class="d-block">SIREN {{ row.siren }}</span>{% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </label>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </form>
                {% endif %}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                {% if actif %}
                    {% if prospect.idDolibarr %}
                        <button type="button"
                                class="btn btn-outline-danger js-dolibarr-unlink"
                                data-form="#js-dolibarr-form-{{ prospect.id }}">
                            <i class="fas fa-link-slash me-1"></i>Retirer la liaison
                        </button>
                    {% endif %}
                    <button type="button"
                            class="btn btn-primary js-dolibarr-link"
                            data-form="#js-dolibarr-form-{{ prospect.id }}"
                            {% if rows is empty %}disabled{% endif %}>
                        <i class="fas fa-link me-1"></i>Lier ce tiers
                    </button>
                {% endif %}
            </div>
        </div>
    </div>
</div>
