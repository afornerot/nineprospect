{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <div class="alert alert-info">
        <i class="fas fa-circle-info"></i>
        Ces types servent uniquement à <strong>pré-remplir</strong> le champ « Type » lors de la création
        d'une action. L'utilisateur peut ensuite saisir librement un texte différent : ce champ n'est pas
        un lien, c'est juste un aide-mémoire.
    </div>

    <a href="{{ path(routesubmit) }}" class="btn btn-success mb-3">Ajouter un type</a>

    <div class="dataTable_wrapper">
        <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%" data-order-col="1" data-order-dir="asc">
            <thead>
            <tr>
                <th width="90px" class="no-sort">Action</th>
                <th>Libellé</th>
                <th>Ordre</th>
                <th>Actif</th>
            </tr>
            </thead>
            <tbody>
                {% for type in types %}
                    <tr>
                        <td>
                            <a href="{{ path(routeupdate, {id: type.id}) }}" title="Modifier"><i class="fas fa-file fa-2x"></i></a>
                        </td>
                        <td>{{ type.libelle }}</td>
                        <td>{{ type.ordre }}</td>
                        <td>{{ type.actif ? 'Oui' : 'Non' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
