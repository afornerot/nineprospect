{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <div class="alert alert-info">
        <i class="fas fa-circle-info"></i>
        {{ prospectsHorsMeta }} prospect(s) sans campagne (hors Meta).
    </div>

    <a href="{{ path(routesubmit) }}" class="btn btn-success mb-3">Ajouter</a>
    <a href="{{ path('app_user_campagnes_bulk') }}" class="btn btn-primary mb-3 ms-1">Affecter en masse</a>

    <div class="dataTable_wrapper">
        <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%" data-order-col="1" data-order-dir="asc">
            <thead>
            <tr>
                <th width="90px" class="no-sort">Action</th>
                <th>Campagne</th>
                <th>Identifiant Meta</th>
                <th>Période</th>
                <th>Budget</th>
                <th>Prospects</th>
                <th>Coût / lead</th>
            </tr>
            </thead>
            <tbody>
                {% for ligne in lignes %}
                    {% set campagne = ligne.campagne %}
                    <tr>
                        <td>
                            <a href="{{ path(routeupdate, {id: campagne.id}) }}" title="Modifier"><i class="fas fa-file fa-2x"></i></a>
                            <a href="{{ path(routeprospect, {campagne: campagne.id}) }}" title="Prospects"><i class="fas fa-building fa-2x"></i></a>
                        </td>
                        <td>{{ campagne.libelle }}</td>
                        <td><code>{{ campagne.externalId }}</code></td>
                        <td data-order="{{ campagne.dateDebut ? campagne.dateDebut|date('Y-m-d') : '' }}">
                            {{ campagne.dateDebut ? campagne.dateDebut|date('d/m/Y') : '—' }}
                            →
                            {{ campagne.dateFin ? campagne.dateFin|date('d/m/Y') : '—' }}
                        </td>
                        <td>{{ campagne.budget ? campagne.budget|number_format(2, ',', ' ') ~ ' €' : '—' }}</td>
                        <td>{{ ligne.prospects }}</td>
                        <td>{{ ligne.cpl ? ligne.cpl|number_format(2, ',', ' ') ~ ' €' : '—' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
