<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Prospect - {{ prospect.nom }}</title>
    <style>
        body { font-family: Arial, sans-serif; font-size: 12px; margin: 20px; }
        h1 { font-size: 18px; border-bottom: 2px solid #333; padding-bottom: 10px; }
        h2 { font-size: 14px; background: #f0f0f0; padding: 5px; margin-top: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ccc; padding: 6px; text-align: left; }
        th { background: #343a40; color: white; }
        .logo { max-height: 60px; max-width: 120px; }
        .footer { margin-top: 30px; font-size: 10px; color: #666; text-align: center; }
    </style>
</head>
<body>
    <h1>
        {% if prospect.logo %}<img src="{{ asset(prospect.logo) }}" class="logo"> {% endif %}
        {{ prospect.nom }}
    </h1>

    <h2>Informations</h2>
    <table>
        <tr><th>Email</th><td>{{ prospect.email ?: '—' }}</td></tr>
        <tr><th>Téléphone</th><td>{{ prospect.telephone ?: '—' }}</td></tr>
        <tr><th>Adresse</th><td>{{ prospect.adresse ?: '—' }} {{ prospect.codePostal }} {{ prospect.ville }}</td></tr>
        <tr><th>SIREN</th><td>{{ prospect.siren ?: '—' }}</td></tr>
        <tr><th>SIRET</th><td>{{ prospect.siret ?: '—' }}</td></tr>
        <tr><th>NAF</th><td>{{ prospect.naf ?: '—' }}</td></tr>
        <tr><th>Site Web</th><td>{{ prospect.siteUrl ?: '—' }}</td></tr>
        <tr><th>LinkedIn</th><td>{{ prospect.linkedinUrl ?: '—' }}</td></tr>
    </table>

    <h2>Suivi</h2>
    <table>
        <tr><th>Contacté</th><td>{{ prospect.contacte ? 'Oui' : 'Non' }}{% if prospect.datePremierContact %} le {{ prospect.datePremierContact|date('d/m/Y') }}{% endif %}</td></tr>
        <tr><th>Qualifié</th><td>{{ prospect.qualifie ? 'Oui' : 'Non' }}</td></tr>
        <tr><th>Campagne</th><td>{{ prospect.campagne ? prospect.campagne.libelle : '—' }}</td></tr>
        <tr><th>Montant devis</th><td>{{ prospect.montantDevis ? prospect.montantDevis|number_format(2, ',', ' ') ~ ' €' : '—' }}</td></tr>
    </table>

    {% if prospect.contacts|length > 0 %}
    <h2>Contacts ({{ prospect.contacts|length }})</h2>
    <table>
        <thead>
            <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Principal</th>
            </tr>
        </thead>
        <tbody>
            {% for contact in prospect.contacts %}
            <tr>
                <td>{{ contact.nomComplet }}</td>
                <td>{{ contact.email ?: '—' }}</td>
                <td>{{ contact.telephone ?: '—' }}</td>
                <td>{{ contact.estPrincipal ? 'Oui' : 'Non' }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}

    {% if prospect.actions|length > 0 %}
    <h2>Actions ({{ prospect.actions|length }})</h2>
    <table>
        <thead>
            <tr>
                <th>Type</th>
                <th>Prévue le</th>
                <th>Réalisée le</th>
                <th>Résultat</th>
            </tr>
        </thead>
        <tbody>
            {% for action in prospect.actions|sort((a, b) => b.datePrevue <=> a.datePrevue) %}
            <tr>
                <td>{{ action.typeAction ?: '—' }}</td>
                <td>{{ action.datePrevue ? action.datePrevue|date('d/m/Y') : '—' }}</td>
                <td>{{ action.dateRealisee ? action.dateRealisee|date('d/m/Y') : '—' }}</td>
                <td>{{ action.resultat ?: '—' }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}

    <div class="footer">
        Document généré le {{ generatedAt|date('d/m/Y à H:i') }}
    </div>
</body>
</html>
